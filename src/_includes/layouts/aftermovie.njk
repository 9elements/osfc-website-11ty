{% extends "layouts/base.njk" %}

{% block content %}
  {% set year = movie.year %}
  {% set navBase = "/aftermovies/" %}
  {% set navYears = aftermovies.items %}

  <section class="archive">
    <img loading="lazy" decoding="async" alt="" class="archive__beam" src="/assets/images/beams/beam-02.svg" aria-hidden="true">
    <div class="wrapper-l | stack-700">
      <h1 class="text-800-major weight-black uppercase leading-tight text-peach">
      Aftermovies
    </h1>
      {% include "partials/year-navigation.njk" %}

      <div class="video video--full" style="--aspect-ratio:16/9;">
        <iframe src="https://player.vimeo.com/video/{{ movie.vimeoId }}?color=4f51a9" width="640" height="360" frameborder="0" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen title="OSFC {{ movie.year }} Aftermovie"></iframe>
      </div>
    </div>
  </section>
{% endblock %}
