<ul class="year-navigation">
  {% for entry in (navYears or years.years) %}
    {% set item = entry.year or entry %}
    <li>
      <a href="{{ navBase or '/archive/' }}{{item}}" class="weight-bold button" aria-current={{"page" if year == item else "default"}}>
        <span class="">{{item}}</span>
      </a>
    </li>
  {% endfor %}
</ul>
